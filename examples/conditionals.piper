-- Conditionals in Piper

-- Absolute value function
const abs = \x ->
  if x < 0
  then 0 - x
  else x

-- Max of two numbers
const max = \a -> \b ->
  if a > b
  then a
  else b

-- Min of two numbers
const min = \a -> \b ->
  if a < b
  then a
  else b

-- Test absolute value
-5 |> abs |> print
10 |> abs |> print

-- Test max
3 |> max <| 7 |> print
15 |> max <| 8 |> print

-- Test min
3 |> min <| 7 |> print
15 |> min <| 8 |> print

