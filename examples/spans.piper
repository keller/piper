-- Spans in Piper
-- Spans are mutable array-like structures

-- Create a span
const s = #[1 2 3 4 5]
s |> print

-- Get element at index
s |> get <| 0 |> print  -- 1
s |> get <| 2 |> print  -- 3

-- Get last element
s |> getLast |> print  -- 5

-- Set element at index (mutates the span)
s |> set <| 0 10
s |> print  -- #[10, 2, 3, 4, 5]

-- Set last element (mutates the span)
s |> setLast <| 99
s |> print  -- #[10, 2, 3, 4, 99]

-- Slice span (returns new span)
const slice_result = s |> slice <| 1 3
slice_result |> print  -- #[2, 3]
s |> print  -- #[10, 2, 3, 4, 99] (original unchanged)

-- Convert to list
const as_list = s |> to_list
as_list |> print  -- [10, 2, 3, 4, 99]

-- Convert from list
const numbers = [100 200 300]
const span_to_span = numbers |> to_span
span_to_span |> print  -- #[100, 200, 300]

-- Stack-like usage with getLast/setLast
const stack = #[1 2 3]
stack |> getLast |> print  -- 3 (peek)
const popped = stack |> getLast  -- Get last before shrinking
const stack2 = stack |> slice <| 0 (-1)  -- -1 excludes last element
popped |> print  -- 3
stack2 |> print  -- #[1, 2]
